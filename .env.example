# Copy this file to .env and fill in values before running locally.
# The docker-compose.yml reads these via ${VAR:-default} syntax.

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED in production: generate with `openssl rand -hex 32`
SECRET_KEY=change-me-in-production

# ── Feature flags ─────────────────────────────────────────────────────────────
# These are the startup defaults. They can also be toggled live from
# Settings → Platform in the web UI (persisted to site_settings.json).
AUTH_ENABLED=false
HISTORY_ENABLED=true
VULN_CHECK_ENABLED=true

# ── NVD enrichment (optional) ─────────────────────────────────────────────────
# Get a free key at https://nvd.nist.gov/developers/request-an-api-key
# Both vars must be set to enable NVD CVSS enrichment.
# NVD_ENABLED=true
# NVD_API_KEY=your-nvd-api-key-here
